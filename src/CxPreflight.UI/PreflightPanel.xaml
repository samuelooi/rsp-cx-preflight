<UserControl x:Class="CxPreflight.UI.PreflightPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CxPreflight.UI"
             Background="#23272E" Foreground="#E6E9EE" FontFamily="Segoe UI" FontSize="12"
             MinWidth="320">
  <UserControl.Resources>
    <!-- Colours follow CX Radar's dark panel. -->
    <SolidColorBrush x:Key="Panel" Color="#23272E" />
    <SolidColorBrush x:Key="Panel2" Color="#2C313A" />
    <SolidColorBrush x:Key="Card" Color="#262A31" />
    <SolidColorBrush x:Key="Strip" Color="#1B1E23" />
    <SolidColorBrush x:Key="Border" Color="#3A414C" />
    <SolidColorBrush x:Key="Muted" Color="#9AA4B1" />
    <SolidColorBrush x:Key="Dim" Color="#8E98A5" />
    <SolidColorBrush x:Key="Accent" Color="#3D9BE9" />
    <SolidColorBrush x:Key="AccentDim" Color="#1E4A70" />
    <BooleanToVisibilityConverter x:Key="Vis" />

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E9EE" />
      <Setter Property="Background" Value="{StaticResource Panel2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource AccentDim}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Vertical tab strip down the left edge, labels reading bottom to top, as in CX Radar. -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="b" Background="{StaticResource Strip}" BorderThickness="0,0,2,0" BorderBrush="Transparent" Padding="0,10">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                  <RotateTransform Angle="-90" />
                </ContentPresenter.LayoutTransform>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="10.5" Width="Auto" Margin="0" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- Header: always visible -->
    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,10">
      <DockPanel>
        <!-- The READY / NOT READY verdict appears here once scoring lands in P1. -->
        <Border DockPanel.Dock="Right" Background="#353B45" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
          <TextBlock Text="P0 PREVIEW" Foreground="#C3CAD4" FontWeight="SemiBold" FontSize="11" />
        </Border>
        <TextBlock Text="{Binding PercentText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,0,10,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding DocumentTitle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ScoringNote}" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Segments}" Margin="0,8,0,8" Height="8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <ui:WeightedPanel Gap="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#353B45" CornerRadius="2" ToolTip="{Binding Tip}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Run checks"
                Command="{Binding RunChecksCommand}" />
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <Border Visibility="{Binding IsStale, Converter={StaticResource Vis}}" Margin="0,10,0,0" Padding="10,8"
              Background="#3A3220" BorderBrush="#B8892C" BorderThickness="1" CornerRadius="5">
        <StackPanel>
          <TextBlock Text="The model changed" Foreground="#F2CF7A" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StaleText}" Foreground="#E2D3AD" TextWrapping="Wrap" Margin="0,2,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Primary}" Content="Re-check" Command="{Binding RunChecksCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Btn}" Content="Later" Command="{Binding DismissStaleCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}" />

    <TabControl TabStripPlacement="Left" Background="{StaticResource Panel}" BorderThickness="0" Padding="0">
      <TabControl.Resources>
        <Style TargetType="TabPanel">
          <Setter Property="Background" Value="{StaticResource Strip}" />
        </Style>
      </TabControl.Resources>

      <TabItem Header="READINESS">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Style="{StaticResource Heading}" Text="LEVELS AND STOREYS · MEASURED" />
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="{Binding StoreysSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Levels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}" Foreground="{StaticResource Muted}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Elevation}" Foreground="{StaticResource Muted}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Heading}" Text="READINESS ITEMS · AGREED WEIGHTS" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Score}" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,2">
                              <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{StaticResource Muted}" Width="96" />
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Score}" Foreground="{StaticResource Muted}" Width="48" />
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="INSPECT"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Inspect arrives in P2: the selected element's IFC class and CX parameters." /></TabItem>
      <TabItem Header="PARAMETERS"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Parameters arrives in P1: load, audit, bulk fill, schedules." /></TabItem>
      <TabItem Header="WARNINGS"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Warnings arrives in P2." /></TabItem>
      <TabItem Header="COMPLIANCE"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Compliance arrives in P2." /></TabItem>
      <TabItem Header="ISSUES"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Issues (BCF and Takeoff edits) arrives in P3." /></TabItem>
      <TabItem Header="USER GUIDE"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="User Guide arrives later." /></TabItem>
      <TabItem Header="FEEDBACK"><TextBlock Margin="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Feedback arrives later." /></TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
